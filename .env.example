# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# API server port
WEB_PORT=3000

# Allowed app origins for CORS (comma-separated). Use * for dev only.
# CORS_ORIGIN=http://localhost:8081,https://your-app.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=customer_service_bot

# Admin dashboard login (change in production!)
ADMIN_PASSWORD=admin123
