# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Run browser headless (no Chrome popup). Set false to debug linking.
WHATSAPP_HEADLESS=true

# Link method: qr (default) or pairing
# WHATSAPP_LINK_METHOD=qr

# Phone for pairing mode — country code + number, no spaces (e.g. 60123456789)
# WHATSAPP_PHONE=60123456789
