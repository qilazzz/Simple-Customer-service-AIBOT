{
  "name": "simple-customer-service-aibot",
  "version": "1.0.0",
  "description": "US Pizza AI customer service API with complaint chatbot and admin dashboard",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make --knexfile knexfile.js",
    "seed": "knex seed:run",
    "db:setup": "knex migrate:latest && knex seed:run",
    "mobile": "npm run start --prefix mobile/us-pizza-app",
    "mobile:install": "npm install --prefix mobile/us-pizza-app"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "chatbot",
    "gemini",
    "customer-service",
    "ai-bot",
    "complaints",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.3"
  }
}
